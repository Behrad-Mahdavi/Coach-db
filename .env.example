# Environment variables for Smart Workout Dashboard Backend

# ===========================================
# DATABASE (PostgreSQL on Liara)
# ===========================================
# NOTE: Use the exact connection string provided by Liara.
# It MUST include the internal network host (e.g., x-eight).
DATABASE_URL="postgresql://root:[DB_PASSWORD_HERE]@[LIARA_INTERNAL_HOST]:5432/postgres?schema=public"

# ===========================================
# REDIS (Cache on Liara)
# ===========================================
# NOTE: Use the exact connection string provided by Liara for your Redis instance.
REDIS_URL="redis://[REDIS_USERNAME]:[REDIS_PASSWORD]@[LIARA_INTERNAL_HOST]:6379"

# ===========================================
# JWT Authentication
# ===========================================
# WARNING: This must be a long, random, generated string (32+ chars) for production.
JWT_SECRET="YOUR-LONG-PRODUCTION-SECRET-GOES-HERE"
JWT_EXPIRES_IN="7d"

# ===========================================
# Application Settings
# ===========================================
# NOTE: NestJS code should use process.env.PORT || 3001
PORT=3001

# Must be set to 'production' on the Liara environment, but 'development' for local use.
NODE_ENV=development

# ===========================================
# Frontend URL (for CORS)
# ===========================================
# NOTE: This must include all allowed origins (local, staging, production).
FRONTEND_URL="http://localhost:5173, https://[YOUR_APP_SUBDOMAIN].liara.run"